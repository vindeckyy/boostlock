[Unit]
Description=Keep CPU boost available with BoostLock
Documentation=https://github.com/vindeckyy/boostlock
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/boostlock start --target 4000 --max-temp 100 --duty 15
ExecStop=/usr/local/bin/boostlock stop
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=10
RuntimeDirectory=boostlock
RuntimeDirectoryMode=0755
ProtectSystem=full
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_NICE
AmbientCapabilities=CAP_SYS_ADMIN CAP_SYS_NICE
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
